# Worth It Supabase project
SUPABASE_URL=https://nhnqenolqepbwskjdrxv.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Server-only key from Supabase Settings > API Keys. Never place this in the mobile app.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# API
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Worker
WORKER_NAME=worth-it-worker-local
WORKER_POLL_INTERVAL_MS=2000
WORKER_LEASE_SECONDS=120

# Providers: use mock first; switch to openai/ebay after adding credentials.
RECOGNITION_PROVIDER=mock
MARKET_PROVIDER=mock

# OpenAI image recognition
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# eBay Browse API (active listings). Create credentials at developer.ebay.com.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_CA

# MVP calculation assumptions. Replace with approved marketplace fee data before production.
DEFAULT_MARKETPLACE_FEE_RATE=0.1325
DEFAULT_FIXED_FEE_AMOUNT_MINOR=0
DEFAULT_TARGET_MARGIN_RATE=0.20

# RevenueCat webhook auth header configured in RevenueCat dashboard.
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_ENTITLEMENT_ID=premium

# Generic rewarded-ad server-to-server verification secret.
AD_WEBHOOK_SECRET=
